{
  "name": "cronos-launchpad-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "Cronos-native launchpad MVP with anti-vamp name protection and VVS graduation path.",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "test": "pnpm --recursive test",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "web:dev": "pnpm --filter @cronos-launchpad/web dev",
    "contracts:test": "pnpm --filter @cronos-launchpad/contracts test",
    "activity:backfill": "pnpm --filter @cronos-launchpad/indexer exec node ../../scripts/backfill-token-tables.mjs",
    "activity:check": "pnpm --filter @cronos-launchpad/indexer exec node ../../scripts/check-token-activity.mjs",
    "audit:high": "pnpm audit --audit-level high"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.19.0",
      "adm-zip": "^0.6.0",
      "lodash-es": "^4.18.1",
      "nanoid": "^3.3.18",
      "undici": "^6.28.0"
    }
  },
  "workspaces": ["apps/*", "packages/*", "contracts"]
}
